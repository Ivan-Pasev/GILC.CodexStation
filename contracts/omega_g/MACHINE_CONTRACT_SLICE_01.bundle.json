    "NonCollapseRule.schema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://g-i-l-c.com/schemas/codexstation/omega-g/NonCollapseRule.schema.json",
      "title": "NonCollapseRule",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "left_type",
        "right_type",
        "disposition",
        "rationale",
        "symmetry",
        "authority_ceiling"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$"
        },
        "left_type": {
          "type": "string",
          "minLength": 1
        },
        "right_type": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "FORBID",
            "DISTINCT_BY_DEFAULT",
            "WITNESS_REQUIRED"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "symmetry": {
          "type": "boolean"
        },
        "authority_ceiling": {
          "type": "string",
          "enum": [
            "NONE",
            "PERMISSION",
            "EXECUTION",
            "CANONICAL",
            "FORMAL",
            "EMPIRICAL"
          ]
        },
        "allowed_witness_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "WITNESS_REQUIRED"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "allowed_witness_types"
            ],
            "properties": {
              "allowed_witness_types": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        }
      ]
    },
